   "source": [
    "# Stage 2: Exploratory Data Analysis\n",
    "\n",
    "This notebook presents descriptive exploratory analysis of the Store Sales competition data. It is organized around clear research questions and uses aggregation before plotting to keep the work understandable and memory-conscious.\n",
    "\n",
    "The comparisons below describe associations and visible patterns. They do **not** establish causal effects. No modeling, validation split, or feature engineering for model input is performed."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "d61b6b23",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-07-15T07:08:48.032169Z",
     "iopub.status.busy": "2026-07-15T07:08:48.031930Z",
     "iopub.status.idle": "2026-07-15T07:08:49.507921Z",
     "shell.execute_reply": "2026-07-15T07:08:49.507313Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Repository root: C:\\Users\\GYDROC\\Documents\\Codex\\2026-07-15\\github-plugin-github-openai-curated-remote\\work\\stage1-repo\n",
      "Training rows loaded once: 3,000,888\n",
      "Training period: 2013-01-01 to 2017-08-15\n"
     ]
    }
   ],
   "source": [
    "from pathlib import Path\n",
    "import zipfile\n",
    "\n",
    "import matplotlib\n",
    "matplotlib.use(\"Agg\")\n",
    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "\n",
    "def find_root(start=Path.cwd()):\n",
    "    # Find the repository root from the current directory or a parent.\n",
    "    for candidate in (start, *start.parents):\n",
    "        if (candidate / \"data\" / \"raw\").exists() and (candidate / \"src\").exists():\n",
    "            return candidate\n",
    "    raise FileNotFoundError(\"Could not locate the repository root.\")\n",
    "\n",
    "\n",
    "def find_raw_file(csv_name):\n",
    "    # Find a CSV directly or inside a ZIP archive in data/raw.\n",
    "    direct = RAW_DIR / csv_name\n",
    "    if direct.exists():\n",
    "        return direct\n",
    "    for archive in sorted(RAW_DIR.glob(\"*.zip\")):\n",
    "        with zipfile.ZipFile(archive) as zipped:\n",
    "            if csv_name in {Path(name).name for name in zipped.namelist()}:\n",
    "                return archive\n",
    "    raise FileNotFoundError(f\"Could not find {csv_name}\")\n",
    "\n",
    "\n",
    "def read_raw_csv(csv_name, **kwargs):\n",
    "    # Read a raw CSV while supporting a compressed training file.\n",
    "    path = find_raw_file(csv_name)\n",
    "    if path.suffix.lower() != \".zip\":\n",
    "        return pd.read_csv(path, **kwargs)\n",
    "    with zipfile.ZipFile(path) as zipped:\n",
    "        member = next(name for name in zipped.namelist() if Path(name).name == csv_name)\n",
    "        with zipped.open(member) as stream:\n",
    "            return pd.read_csv(stream, **kwargs)\n",
    "\n",
    "\n",
    "ROOT = find_root()\n",
    "RAW_DIR = ROOT / \"data\" / \"raw\"\n",
    "FIGURE_DIR = ROOT / \"reports\" / \"figures\" / \"eda\"\n",
    "REPORT_PATH = ROOT / \"reports\" / \"eda_summary.md\"\n",
    "FIGURE_DIR.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "plt.style.use(\"seaborn-v0_8-whitegrid\")\n",
    "COLORS = {\"blue\": \"#3266a8\", \"orange\": \"#dd7f2a\", \"green\": \"#3b8c6e\", \"red\": \"#b64a4a\"}\n",
    "\n",
    "train = read_raw_csv(\n",
    "    \"train.csv\",\n",
    "    usecols=[\"date\", \"store_nbr\", \"family\", \"sales\", \"onpromotion\"],\n",
    "    parse_dates=[\"date\"],\n",
    ")\n",
    "stores = read_raw_csv(\"stores.csv\")\n",
    "transactions = read_raw_csv(\"transactions.csv\", parse_dates=[\"date\"])\n",
    "holidays = read_raw_csv(\"holidays_events.csv\", parse_dates=[\"date\"])\n",
    "oil = read_raw_csv(\"oil.csv\", parse_dates=[\"date\"])\n",
    "\n",
    "daily_sales = train.groupby(\"date\", as_index=False)[\"sales\"].sum()\n",
    "daily_sales[\"sales_7d\"] = daily_sales[\"sales\"].rolling(7, center=True, min_periods=1).mean()\n",
    "store_daily = train.groupby([\"date\", \"store_nbr\"], as_index=False)[\"sales\"].sum()\n",
    "\n",
    "print(f\"Repository root: {ROOT}\")\n",
    "print(f\"Training rows loaded once: {len(train):,}\")\n",
    "print(f\"Training period: {train['date'].min().date()} to {train['date'].max().date()}\")"
   ]
  },
