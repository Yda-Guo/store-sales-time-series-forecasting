     "text": [
      "Weekend average daily sales: 798,657\n",
      "Weekday average daily sales: 573,143\n"
     ]
    }
   ],
   "source": [
    "weekday_order = [\"Monday\", \"Tuesday\", \"Wednesday\", \"Thursday\", \"Friday\", \"Saturday\", \"Sunday\"]\n",
    "daily_calendar = daily_sales.assign(\n",
    "    weekday=pd.Categorical(daily_sales[\"date\"].dt.day_name(), categories=weekday_order, ordered=True),\n",
    "    month=daily_sales[\"date\"].dt.month,\n",
    ")\n",
    "weekday_sales = daily_calendar.groupby(\"weekday\", observed=False)[\"sales\"].mean()\n",
    "month_sales = daily_calendar.groupby(\"month\")[\"sales\"].mean().reindex(range(1, 13))\n",
    "month_names = [\"Jan\", \"Feb\", \"Mar\", \"Apr\", \"May\", \"Jun\", \"Jul\", \"Aug\", \"Sep\", \"Oct\", \"Nov\", \"Dec\"]\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(9, 4.5))\n",
    "weekday_sales.plot.bar(ax=ax, color=COLORS[\"blue\"])\n",
    "ax.set(title=\"Average Aggregate Sales by Weekday\", xlabel=\"Weekday\", ylabel=\"Average daily total sales\")\n",
    "ax.tick_params(axis=\"x\", rotation=30)\n",
    "fig.tight_layout(); fig.savefig(FIGURE_DIR / \"02_weekday_sales.png\", dpi=150); plt.close(fig)\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(9, 4.5))\n",
    "ax.bar(month_names, month_sales, color=COLORS[\"green\"])\n",
    "ax.set(title=\"Average Aggregate Sales by Calendar Month\", xlabel=\"Month\", ylabel=\"Average daily total sales\")\n",
    "fig.tight_layout(); fig.savefig(FIGURE_DIR / \"03_monthly_sales.png\", dpi=150); plt.close(fig)\n",
    "\n",
    "weekend_mean = daily_calendar.loc[daily_calendar[\"date\"].dt.dayofweek >= 5, \"sales\"].mean()\n",
    "weekday_mean = daily_calendar.loc[daily_calendar[\"date\"].dt.dayofweek < 5, \"sales\"].mean()\n",
    "print(f\"Weekend average daily sales: {weekend_mean:,.0f}\")\n",
    "print(f\"Weekday average daily sales: {weekday_mean:,.0f}\")"
   ]
