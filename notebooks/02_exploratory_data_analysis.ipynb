   "source": [
    "fig, ax = plt.subplots(figsize=(12, 5))\n",
    "ax.plot(daily_sales[\"date\"], daily_sales[\"sales\"], color=COLORS[\"blue\"], alpha=0.35, linewidth=0.7, label=\"Daily total\")\n",
    "ax.plot(daily_sales[\"date\"], daily_sales[\"sales_7d\"], color=COLORS[\"red\"], linewidth=1.6, label=\"Centered 7-day average\")\n",
    "ax.set(title=\"Total Daily Sales and Descriptive 7-Day Average\", xlabel=\"Date\", ylabel=\"Total sales\")\n",
    "ax.legend(frameon=False)\n",
    "fig.tight_layout()\n",
    "fig.savefig(FIGURE_DIR / \"01_daily_sales.png\", dpi=150)\n",
    "plt.close(fig)\n",
    "\n",
    "yearly_daily = daily_sales.assign(year=daily_sales[\"date\"].dt.year).groupby(\"year\")[\"sales\"].mean()\n",
